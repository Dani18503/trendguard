# ============================================
# TrendGuard - Configuracion de entorno
# ============================================
# Copia este archivo a .env y rellena con tus valores.
# NUNCA subas el .env real a Git.

# --- Binance Futures (Testnet o Real) ---
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_API_SECRET=tu_api_secret_aqui
BINANCE_TESTNET=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
TELEGRAM_CHAT_ID=-1003714719859

# --- Trading ---
SYMBOL=BTC/USDT:USDT
LEVERAGE=3
RISK_PER_TRADE=0.01
TIMEFRAME=15m

# --- Modo de operacion ---
# simple = solo lo esencial | pro = configuracion avanzada
MODE=simple

# --- Trailing Stop ---
TRAILING_TRIGGER_PCT=1.0
TRAILING_DISTANCE_PCT=0.5

# --- Logging ---
LOG_LEVEL=INFO
